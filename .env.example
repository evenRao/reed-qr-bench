# Copy to .env and configure locally. Never commit real credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Managed LiveKit Inference; no separate model-provider key.
LIVEKIT_REALTIME_MODEL=xai/grok-voice-3.0
# Leave blank for the model default (eve for Grok). Match the chosen model.
LIVEKIT_REALTIME_VOICE=

# Optional uploaded-image benchmarks. Keep keys on the backend.
# Select an image/tool-capable model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
